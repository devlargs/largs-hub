// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildPrivacyScript > draws the default top-half cover and no side cover 1`] = `
"
    (function() {
      const panels = [
        ['__largs_privacy_overlay__', 'position:fixed;top:0;left:0;background:#181825;z-index:2147483647;pointer-events:none;width:100vw;height:50vh;opacity:1;'],
        ['__largs_privacy_overlay_h__', ''],
      ];
      for (const [id, css] of panels) {
        const existing = document.getElementById(id);
        if (!css) { if (existing) existing.remove(); continue; }
        if (existing) { existing.style.cssText = css; continue; }
        const el = document.createElement('div');
        el.id = id;
        el.style.cssText = css;
        document.documentElement.appendChild(el);
      }
    })()
  "
`;

exports[`clampPercent > builds a parseable Reddit video probe with the point baked in 1`] = `
"
  (() => {
    const x = 121, y = 48;
    const isPlayer = (el) => /^SHREDDIT-PLAYER/.test(el.tagName || '');
    let el = document.elementFromPoint(x, y);
    const seen = new Set();
    while (el && el.shadowRoot && !seen.has(el)) {
      seen.add(el);
      const inner = el.shadowRoot.elementFromPoint(x, y);
      if (!inner || inner === el) break;
      el = inner;
    }
    let player = null, video = null;
    for (let node = el; node && !player; node = node.parentElement || (node.getRootNode().host || null)) {
      if (!video && node.tagName === 'VIDEO') video = node;
      if (isPlayer(node)) player = node;
    }
    if (!player) {
      for (const p of document.querySelectorAll('shreddit-player, shreddit-player-2')) {
        const r = p.getBoundingClientRect();
        if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) { player = p; break; }
      }
    }
    if (!player && !video) return null;
    if (!video && player) {
      video = player.querySelector('video') || (player.shadowRoot && player.shadowRoot.querySelector('video'));
    }
    const attributes = {};
    if (player) {
      for (const a of player.attributes) {
        if (a.value.includes('redd.it') && a.value.length <= 200000) attributes[a.name] = a.value;
      }
    }
    return { attributes, videoSrc: video ? (video.currentSrc || video.src || '') : '' };
  })()
"
`;

exports[`service view scripts > APPLY_BLUR_SCRIPT parses and matches its snapshot 1`] = `
"
    (function() {
      if (document.getElementById('__largs_blur_overlay__')) return;
      const el = document.createElement('div');
      el.id = '__largs_blur_overlay__';
      el.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);z-index:2147483647;pointer-events:none;transition:opacity 0.15s ease;';
      document.documentElement.appendChild(el);
    })()
  "
`;

exports[`service view scripts > AUTO_START_CALL_SCRIPT parses and matches its snapshot 1`] = `
"
  (() => new Promise((resolve) => {
    const deadline = Date.now() + 15000;
    const scan = () => {
      for (const el of document.querySelectorAll('div[role="button"], button')) {
        const label = (el.getAttribute('aria-label') || '').trim();
        const text = (el.textContent || '').trim();
        if (/^start call$/i.test(label) || /^start call$/i.test(text)) {
          el.click();
          resolve(true);
          return;
        }
      }
      if (Date.now() < deadline) setTimeout(scan, 300);
      else resolve(false);
    };
    scan();
  }))()
"
`;

exports[`service view scripts > GOOGLE_MESSAGES_STATUS_SCRIPT parses and matches its snapshot 1`] = `
"
  (() => {
    const paired = !!document.querySelector('mws-conversations-list, mws-conversation-list-item, [data-e2e-conversation]');
    const selectors = '[role="alert"], [role="status"], [class*="banner" i], mws-banner, [class*="snackbar" i]';
    const banners = [];
    for (const el of document.querySelectorAll(selectors)) {
      const text = (el.innerText || el.textContent || '').trim().replace(/\\s+/g, ' ');
      if (text && text.length <= 300 && !banners.includes(text)) banners.push(text);
      if (banners.length >= 20) break;
    }
    return { paired, banners };
  })()
"
`;

exports[`service view scripts > HANGUP_SCRIPT parses and matches its snapshot 1`] = `
"
  (() => {
    const rx = /end call|leave call|hang ?up|end room/i;
    for (const el of document.querySelectorAll('div[role="button"], button, [aria-label]')) {
      const label = (el.getAttribute('aria-label') || '').trim();
      if (label && rx.test(label)) { el.click(); return true; }
    }
    return false;
  })()
"
`;

