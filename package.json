{
  "name": "largs-hub",
  "version": "0.1.73",
  "description": "An open-source workspace browser — manage all your web apps in one place",
  "main": "dist-electron/main.js",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "vite:dev": "vite",
    "build": "tsc && vite build && npm run clean:electron && tsc -p tsconfig.electron.json",
    "clean:electron": "node -e \"require('fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "preview": "vite preview",
    "dev": "npm run clean:electron && tsc -p tsconfig.electron.json && concurrently \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"electronmon . --dev\"",
    "electron:build": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "electronmon": {
    "patterns": [
      "dist-electron/**"
    ]
  },
  "keywords": [
    "electron",
    "workspace",
    "browser",
    "rambox-alternative"
  ],
  "author": "Ralph Largo",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^11.0.2",
    "react-icons": "^5.7.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.largshub.app",
    "productName": "Largs Hub",
    "icon": "assets/ico/icon.ico",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/ico/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/ico/icon.ico"
    },
    "afterPack": "scripts/mac-adhoc-sign.cjs",
    "nsis": {
      "artifactName": "${productName} Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icns/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "minimumSystemVersion": "13.0"
    },
    "dmg": {
      "artifactName": "Largs-Hub-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "devlargs",
      "repo": "largs-hub"
    }
  }
}
